# Django
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (local docker compose defaults — see docker-compose.yml)
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=baby_tracker
POSTGRES_USER=baby_tracker
POSTGRES_PASSWORD=baby_tracker
# Optional pytest DB name (created/destroyed each run unless --reuse-db):
# POSTGRES_TEST_DB=test_baby_tracker

# TLS-terminating reverse proxy that overwrites X-Forwarded-Proto.
# Enables SSL redirect, secure cookies, and SECURE_PROXY_SSL_HEADER together.
# Do not set this if gunicorn's port is reachable directly by clients.
# DJANGO_BEHIND_PROXY=true
