# Django
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL — local compose defaults (local settings only).
# Production settings require POSTGRES_DB, POSTGRES_USER, POSTGRES_PASSWORD,
# and POSTGRES_HOST to be set explicitly (no silent defaults).
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=baby_tracker
POSTGRES_USER=baby_tracker
POSTGRES_PASSWORD=baby_tracker
# Optional:
# POSTGRES_TEST_DB=test_baby_tracker
# POSTGRES_CONNECT_TIMEOUT=5
# POSTGRES_READY_TIMEOUT=60

# OpenTelemetry. Leave unset when no collector is running.
# OTLP/HTTP traces go to this collector address. The app does not read or
# send a vendor API key (no Honeycomb header, no OTEL_EXPORTER_OTLP_HEADERS).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# Full traces URL, if you do not want /v1/traces appended:
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://127.0.0.1:4318/v1/traces

# Public site. Required behind the Cloudflare Tunnel.
# DJANGO_CSRF_TRUSTED_ORIGINS=https://baby.thewalawalas.com
# DJANGO_ALLOWED_HOSTS=baby.thewalawalas.com

# Optional product settings.
# EVENT_FUTURE_TOLERANCE_SECONDS=120
# TIMELINE_POLL_MS=5000
# LOGIN_MAX_FAILURES=5
# LOGIN_WINDOW_SECONDS=900
# LOGIN_LOCKOUT_SECONDS=900
# INVITE_TTL_HOURS=72
# IMPORT_RETENTION_DAYS=14
# IMPORT_ROOT=/var/lib/baby-tracker/imports
# IMPORT_MAX_BYTES=5000000
# READY_TIMEOUT_SECONDS=2
# BACKUP_DIR=/var/lib/baby-tracker/backups
# BACKUP_RETENTION_DAYS=14
# BACKUP_ENCRYPTION_KEY=set-in-the-secret-store

# First household. The bootstrap command refuses to run if any of these are missing.
# BOOTSTRAP_ADMIN_USERNAME=
# BOOTSTRAP_ADMIN_PASSWORD=
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_HOUSEHOLD_NAME=
# BOOTSTRAP_BABY_NAME=
# BOOTSTRAP_TIMEZONE=America/Los_Angeles

# TLS-terminating reverse proxy that overwrites X-Forwarded-Proto.
# Enables SSL redirect, secure cookies, SECURE_PROXY_SSL_HEADER, and HSTS
# together. Do not set this if gunicorn's port is reachable directly by clients.
# DJANGO_BEHIND_PROXY=true
