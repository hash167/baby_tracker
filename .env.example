# Local / production secrets (copy to .env and fill in)
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Optional:
# DJANGO_DB_PATH=/app/data/db.sqlite3

# TLS-terminating reverse proxy that overwrites X-Forwarded-Proto.
# Enables SSL redirect, secure cookies, and SECURE_PROXY_SSL_HEADER together.
# Do not set this if gunicorn's port is reachable directly by clients.
# DJANGO_BEHIND_PROXY=true

# SQLite: run a single replica of this image (one writer). Multiple replicas
# sharing the same db file can lock or corrupt the database.
