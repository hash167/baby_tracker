# Django
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL — local compose defaults (local settings only).
# Production settings require POSTGRES_DB, POSTGRES_USER, POSTGRES_PASSWORD,
# and POSTGRES_HOST to be set explicitly (no silent defaults).
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=baby_tracker
POSTGRES_USER=baby_tracker
POSTGRES_PASSWORD=baby_tracker
# Optional:
# POSTGRES_TEST_DB=test_baby_tracker
# POSTGRES_CONNECT_TIMEOUT=5
# POSTGRES_READY_TIMEOUT=60

# OpenTelemetry. Leave unset when no collector is running.
# OTLP/HTTP traces go to this collector address. The app does not read or
# send a vendor API key (no Honeycomb header, no OTEL_EXPORTER_OTLP_HEADERS).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# Full traces URL, if you do not want /v1/traces appended:
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://127.0.0.1:4318/v1/traces

# TLS-terminating reverse proxy that overwrites X-Forwarded-Proto.
# Enables SSL redirect, secure cookies, SECURE_PROXY_SSL_HEADER, and HSTS
# together. Do not set this if gunicorn's port is reachable directly by clients.
# DJANGO_BEHIND_PROXY=true
